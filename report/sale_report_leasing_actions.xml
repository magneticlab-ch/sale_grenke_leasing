<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Action d'impression dediee : "Devis financement Grenke" -->
    <record id="action_report_saleorder_leasing" model="ir.actions.report">
        <field name="name">Devis financement Grenke</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sale_grenke_leasing.report_saleorder_leasing</field>
        <field name="report_file">sale_grenke_leasing.report_saleorder_leasing</field>
        <!-- Meme paperformat que le devis standard (sale.report_saleorder) pour un
             calage d'en-tete identique ; sinon le defaut societe (DIN5008) decale. -->
        <field name="paperformat_id" ref="base.paperformat_euro"/>
        <field name="print_report_name">'Devis financement - %s' % (object.name)</field>
        <!-- Pas de liaison au menu Imprimer : une liaison est visible dans toutes les
             societes. Le rapport se lance par le bouton « Devis financement Grenke »
             du devis, affiche uniquement si la societe a le leasing Grenke. -->
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
