<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================= -->
    <!--  Rapport dedie "Devis financement Grenke"                         -->
    <!--  Lignes du devis SANS prix (Description + Quantite) + financement -->
    <!-- ================================================================= -->

    <!-- Wrapper : itere sur les devis selectionnes -->
    <template id="report_saleorder_leasing">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="sale_grenke_leasing.report_saleorder_leasing_document"
                   t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>

    <!-- Document -->
    <template id="report_saleorder_leasing_document">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
            <div class="page">

                <!-- En-tete devis (sans montants) -->
                <h2 style="margin-bottom:4px;">
                    Devis <span t-field="doc.name"/>
                </h2>
                <table width="100%" style="border-collapse:collapse; margin-bottom:16px; font-size:10pt;">
                    <tr>
                        <td style="width:60%; vertical-align:top;">
                            <strong>Client :</strong>
                            <span t-field="doc.partner_id.commercial_company_name"/>
                            <t t-if="not doc.partner_id.commercial_company_name">
                                <span t-field="doc.partner_id.name"/>
                            </t>
                        </td>
                        <td style="width:40%; text-align:right; vertical-align:top;">
                            <t t-if="doc.date_order">
                                <strong>Date :</strong>
                                <span t-field="doc.date_order" t-options='{"widget": "date"}'/><br/>
                            </t>
                            <t t-if="doc.client_order_ref">
                                <strong>Reference :</strong>
                                <span t-field="doc.client_order_ref"/>
                            </t>
                        </td>
                    </tr>
                </table>

                <!-- Tableau des lignes : Description + Quantite uniquement -->
                <table width="100%" style="border-collapse:collapse; font-size:10pt;">
                    <thead>
                        <tr style="border-bottom:2px solid #333;">
                            <th style="padding:6px 8px; text-align:left; width:80%;">Description</th>
                            <th style="padding:6px 8px; text-align:right; width:20%;">Quantite</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="doc.order_line" t-as="line">
                            <t t-if="not line.display_type">
                                <tr style="border-bottom:1px solid #e0e0e0;">
                                    <td style="padding:5px 8px; text-align:left;">
                                        <span t-field="line.name"/>
                                    </td>
                                    <td style="padding:5px 8px; text-align:right;">
                                        <span t-field="line.product_uom_qty"
                                              t-options='{"widget": "float", "decimal_precision": "Product Unit of Measure"}'/>
                                        <span t-field="line.product_uom_id"/>
                                    </td>
                                </tr>
                            </t>
                            <t t-elif="line.display_type == 'line_section'">
                                <tr style="background-color:#f5f5f5;">
                                    <td colspan="2" style="padding:6px 8px; font-weight:bold;">
                                        <span t-field="line.name"/>
                                    </td>
                                </tr>
                            </t>
                            <t t-elif="line.display_type == 'line_note'">
                                <tr>
                                    <td colspan="2" style="padding:4px 8px; font-style:italic; color:#666;">
                                        <span t-field="line.name"/>
                                    </td>
                                </tr>
                            </t>
                        </t>
                    </tbody>
                </table>

                <!-- ========================================================= -->
                <!--  PAGE : FINANCEMENT                                        -->
                <!-- ========================================================= -->
                <t t-if="doc.leasing_enabled and doc.leasing_amount">

                    <div style="page-break-before:always; margin-top:120px; border-top:2px solid #E30613;">&#160;</div>

                    <div style="margin-top:16px; margin-bottom:12px;">
                        <table width="100%" style="border-collapse:collapse;">
                            <tr>
                                <td style="width:60%;">
                                    <h3 style="color:#E30613; margin:0; font-size:14pt;">
                                        Financement - Grenke Leasing
                                    </h3>
                                </td>
                                <td style="width:40%; text-align:right; vertical-align:top;">
                                    <p style="font-size:9pt; color:#888; margin:0;">
                                        Duree : <strong><t t-out="doc.leasing_duration_int"/> mois</strong>
                                    </p>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <table width="100%" style="border-collapse:collapse; font-size:10pt; margin-bottom:10px;">
                        <thead>
                            <tr style="background-color:#E30613; color:white;">
                                <th style="padding:8px 10px; text-align:left; width:55%;">Description</th>
                                <th style="padding:8px 10px; text-align:right; width:20%;">Calcul</th>
                                <th style="padding:8px 10px; text-align:right; width:25%;">Montant HT (CHF)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr style="background-color:#FDE8E8;">
                                <td style="padding:10px; border-bottom:1px solid #f0d0d0; font-weight:bold;">Mensualite HT</td>
                                <td style="padding:10px; text-align:right; border-bottom:1px solid #f0d0d0; color:#555; font-size:9pt;">
                                    <t t-out="'%.2f' % doc.leasing_amount"/> x <t t-out="'%.2f' % doc.leasing_rate"/>%
                                </td>
                                <td style="padding:10px; text-align:right; border-bottom:1px solid #f0d0d0; font-weight:bold; font-size:12pt; color:#E30613;">
                                    CHF <t t-out="'%.2f' % doc.leasing_monthly"/> / mois
                                </td>
                            </tr>
                            <tr style="background-color:#FEF2F2;">
                                <td style="padding:7px 10px; border-bottom:1px solid #f0d0d0;">
                                    Total loyers (<t t-out="doc.leasing_duration_int"/> mensualites)
                                </td>
                                <td style="padding:7px 10px; text-align:right; border-bottom:1px solid #f0d0d0; color:#888; font-size:9pt;">
                                    <t t-out="'%.2f' % doc.leasing_monthly"/> x <t t-out="doc.leasing_duration_int"/>
                                </td>
                                <td style="padding:7px 10px; text-align:right; border-bottom:1px solid #f0d0d0;">
                                    CHF <t t-out="'%.2f' % doc.leasing_total_rent"/>
                                </td>
                            </tr>
                            <tr style="background-color:#FEF2F2;">
                                <td style="padding:7px 10px; border-bottom:1px solid #f0d0d0;">Frais de dossier (versement unique a la signature)</td>
                                <td style="padding:7px 10px; text-align:right; border-bottom:1px solid #f0d0d0; color:#888; font-size:9pt;">forfait</td>
                                <td style="padding:7px 10px; text-align:right; border-bottom:1px solid #f0d0d0;">
                                    CHF <t t-out="'%.2f' % doc.leasing_dossier_fee"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <table width="100%" style="font-size:8.5pt; color:#666; border-top:1px solid #f0d0d0; margin-top:4px;">
                        <tr>
                            <td style="width:50%; padding:4px 6px; vertical-align:top;">
                                <strong>Garantie 48h Grenke :</strong> Facture reglee dans les 48h des docs complets.<br/>
                                <strong>Paiement :</strong> Debit direct trimestriel, le 1er jour du trimestre.<br/>
                                <span style="color:#888;">Mensuel : +2% / loyer &#8226; Sur facture : +CHF 20.- HT / loyer.</span><br/>
                                <strong>Assurance :</strong> non incluse, a convenir separement.
                            </td>
                            <td style="width:50%; padding:4px 6px; vertical-align:top;">
                                <strong>Licences :</strong> Uniquement perpetuelles ou transferables.<br/>
                                <strong>Avantage fiscal CH :</strong> Loyers deductibles a 100% comme charges d'exploitation.
                            </td>
                        </tr>
                    </table>

                    <div style="margin-top:8px; font-size:8pt; color:#AAA; text-align:center;">
                        GRENKELEASING SA - Geneve - Chemin du Pavillon 2, CH-1218 Le Grand-Saconnex - IDE : CHE-105.217.027 TVA - Bareme Super Lease janvier 2026
                    </div>

                    <!-- ===================================================== -->
                    <!--  PAGE : Fiche de renseignements Grenke                -->
                    <!-- ===================================================== -->
                    <div style="page-break-before:always;">&#160;</div>

                    <!-- En-tete Grenke -->
                    <table width="100%" style="border-collapse:collapse; margin-top:120px; margin-bottom:20px;">
                        <tr>
                            <td style="width:55%; vertical-align:top; font-size:8pt; color:#555;">
                                <strong>GRENKELEASING SA - Geneve</strong><br/>
                                IDE : CHE-105.217.027 // CHE-105.217.027 TVA<br/>
                                Certifie selon DIN EN ISO 9001:2015
                            </td>
                            <td style="width:45%; text-align:right; vertical-align:top;">
                                <span style="font-size:32pt; font-weight:bold; letter-spacing:-2px; color:#000;">grenke</span>
                                <br/>
                                <span style="font-size:7.5pt; color:#666;">
                                    Chemin du Pavillon 2, CH-1218 Le Grand-Saconnex<br/>
                                    +41 22 761 62 00 | geneve@grenke.ch | www.grenke.ch
                                </span>
                            </td>
                        </tr>
                    </table>

                    <!-- Titre -->
                    <h2 style="font-size:16pt; font-weight:bold; margin-bottom:24px; margin-top:10px; border-bottom:1px solid #ccc; padding-bottom:8px;">
                        Fiche de renseignements pour la demande de leasing
                    </h2>

                    <!-- Champs principaux -->
                    <table width="100%" style="border-collapse:collapse; margin-bottom:20px;">
                        <tr>
                            <td style="width:35%; padding:6px 0; font-size:10pt;">Fournisseur</td>
                            <td style="width:65%; padding:6px 0; border-bottom:1px solid #333; font-size:10pt;">
                                <t t-out="doc.company_id.name"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding:6px 0; font-size:10pt;">Objet</td>
                            <td style="padding:6px 0; border-bottom:1px solid #333; font-size:10pt;">
                                Materiel/logiciel informatique
                            </td>
                        </tr>
                        <tr>
                            <td style="padding:6px 0; font-size:10pt;">Prix CHF (hors taxe)</td>
                            <td style="padding:6px 0; border-bottom:1px solid #333; font-size:10pt; width:40%;">
                                <t t-out="'%.2f' % doc.leasing_amount"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding:6px 0; font-size:10pt;">Duree/mois</td>
                            <td style="padding:6px 0; border-bottom:1px solid #333; font-size:10pt; width:40%;">
                                <t t-out="doc.leasing_duration_int"/>
                            </td>
                        </tr>
                    </table>

                    <div style="height:16px;"/>

                    <!-- Champs client -->
                    <table width="100%" style="border-collapse:collapse; margin-bottom:20px;">
                        <tr>
                            <td style="width:38%; padding:7px 0; font-size:10pt;">Nom et prenom ou raison sociale</td>
                            <td style="width:62%; padding:7px 0; border-bottom:1px solid #333; font-size:10pt;">
                                <t t-out="doc.partner_id.commercial_company_name or doc.partner_id.name"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding:7px 0; font-size:10pt;">Adresse</td>
                            <td style="padding:7px 0; border-bottom:1px solid #333; font-size:10pt;">
                                <t t-out="doc.partner_invoice_id.street or ''"/>
                                <t t-if="doc.partner_invoice_id.street2">
                                    , <t t-out="doc.partner_invoice_id.street2"/>
                                </t>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding:7px 0; font-size:10pt;">NPA/Lieu</td>
                            <td style="padding:7px 0; border-bottom:1px solid #333; font-size:10pt;">
                                <t t-out="doc.partner_invoice_id.zip or ''"/>
                                <t t-out="' ' + doc.partner_invoice_id.city if doc.partner_invoice_id.city else ''"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding:7px 0; font-size:10pt; vertical-align:bottom;">Tel</td>
                            <td style="padding:7px 0; font-size:10pt;">
                                <table width="100%" style="border-collapse:collapse;">
                                    <tr>
                                        <td style="width:40%; border-bottom:1px solid #333;">
                                            <t t-out="doc.partner_id.phone or ''"/>
                                        </td>
                                        <td style="width:5%; text-align:center; font-size:10pt;">Email</td>
                                        <td style="width:55%; border-bottom:1px solid #333;">
                                            <t t-out="doc.partner_id.email or ''"/>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <!-- Section entreprises individuelles -->
                    <div style="margin-top:16px; margin-bottom:8px;">
                        <span style="font-size:10pt; text-decoration:underline;">
                            Pour les entreprises individuelles et independants
                        </span>
                    </div>
                    <table width="100%" style="border-collapse:collapse; margin-bottom:12px;">
                        <tr>
                            <td style="width:35%; padding:7px 0; font-size:10pt;">Adresse privee</td>
                            <td style="width:65%; padding:7px 0; border-bottom:1px solid #333; font-size:10pt;">
                                &#160;
                            </td>
                        </tr>
                        <tr>
                            <td style="padding:7px 0; font-size:10pt;">Date de naissance</td>
                            <td style="padding:7px 0; font-size:10pt;">
                                <table width="100%" style="border-collapse:collapse;">
                                    <tr>
                                        <td style="width:38%; border-bottom:1px solid #333;">&#160;</td>
                                        <td style="width:4%;"/>
                                        <td style="width:20%; font-size:10pt;">Proprietaire</td>
                                        <td style="width:10%; font-size:10pt;">Oui</td>
                                        <td style="width:10%; font-size:10pt;">Non</td>
                                        <td style="width:18%;"/>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <!-- Zone signature -->
                    <div style="height:30px;"/>
                    <table width="100%" style="border-collapse:collapse; margin-bottom:8px;">
                        <tr>
                            <td style="width:42%; border-bottom:2px solid #333;"/>
                            <td style="width:8%;"/>
                            <td style="width:50%; border-bottom:2px solid #333;"/>
                        </tr>
                        <tr>
                            <td style="padding-top:4px; font-size:10pt; font-weight:bold;">Lieu et date</td>
                            <td/>
                            <td style="padding-top:4px; font-size:10pt; font-weight:bold;">Signature</td>
                        </tr>
                    </table>

                    <!-- Texte legal -->
                    <div style="margin-top:16px; font-size:8pt; font-style:italic; color:#333; text-align:justify;">
                        En apposant sa signature, le demandeur de leasing certifie la veracite des elements ci-dessus.
                        Il prend acte des consequences auxquelles il s'expose dans l'hypothese ou des indications
                        incorrectes sont fournies. Il certifie qu'aucun element de nature a influencer la conclusion
                        du contrat de leasing n'a ete tenu sous silence.
                        Nous autorisons Grenkeleasing SA a prendre et a donner tous renseignements utiles pour l'etude
                        de cette demande de leasing aupres des banques, le service central pour des informations de
                        credit (ZEK), de l'Office de poursuites ou de tout autre service officiel.
                    </div>

                    <!-- Complements -->
                    <div style="margin-top:16px; font-size:9pt;">
                        <strong>Complements :</strong>
                        <ul style="margin:4px 0 0 20px;">
                            <li>Copie de la piece d'identite, valide et recto-verso</li>
                            <li>Attestation de la Caisse AVS pour les independants pas inscrits au Registre du commerce</li>
                        </ul>
                    </div>

                    <!-- Encadre retour document -->
                    <div style="margin-top:20px; border:1px solid #333; padding:10px; text-align:center; font-size:10pt; font-weight:bold;">
                        Document a nous retourner a : geneve@grenke.ch
                    </div>

                    <!-- Pied de page Grenke -->
                    <div style="margin-top:30px; border-top:1px solid #ccc; padding-top:8px;">
                        <table width="100%" style="border-collapse:collapse;">
                            <tr>
                                <td style="width:50%; font-size:7.5pt; color:#555; vertical-align:top;">
                                    <strong>GRENKELEASING SA - Geneve</strong><br/>
                                    IDE : CHE-105.217.027 // CHE-105.217.027 TVA<br/>
                                    Certifie selon DIN EN ISO 9001:2015
                                </td>
                                <td style="width:50%; text-align:right; font-size:7.5pt; color:#555; vertical-align:top;">
                                    <strong>Adresse :</strong><br/>
                                    Chemin du Pavillon 2 | CH-1218 Le Grand-Saconnex<br/>
                                    +41 22 761 62 00 | geneve@grenke.ch | www.grenke.ch
                                </td>
                            </tr>
                        </table>
                    </div>

                </t>
            </div>
        </t>
    </template>

</odoo>
